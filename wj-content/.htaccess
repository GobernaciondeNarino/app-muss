# Musa Café · Carpeta de contenido
# Se permiten los audios generados y las imágenes subidas;
# la configuración, los datos y los registros quedan bloqueados.

Options -Indexes

<FilesMatch "\.(json|log|lock|php|phtml|phar)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
